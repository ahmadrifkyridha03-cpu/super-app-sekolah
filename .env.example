# ==============================================================================
# TEMPLATE VARIABEL LINGKUNGAN (.env.example)
# Platform Sistem Informasi Akademik, CBT & E-Rapor Sekolah Terpadu
#
# Petunjuk:
# Salin file ini menjadi '.env' di server lokal atau produksi sebelum menjalankan aplikasi:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KUNCI KONFIGURASI BASIS DATA (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# SUPABASE TRANSACTION POOLER (Port 6543) - Wajib untuk Next.js Serverless di Vercel:
# Dapatkan di: Supabase Dashboard > Project Settings > Database > Connection String > URI (Mode: Transaction)
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# SUPABASE DIRECT CONNECTION (Port 5432) - Wajib untuk Prisma db push / migrasi schema:
# Dapatkan di: Supabase Dashboard > Project Settings > Database > Connection String > URI (Mode: Session / Direct)
DIRECT_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Kunci rahasia enkripsi JWT sesi (Minimal 32 karakter acak!)
# Generate di terminal: openssl rand -base64 32
JWT_SECRET="kunci-rahasia-enkripsi-minimal-32-karakter"

# Alamat URL publik aplikasi web
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Role Switcher (1-Klik beralih peran Admin, Guru, Wali Kelas, Siswa)
# PERINGATAN: WAJIB diset "false" di server produksi (hanya aktif di komputer pengembang)!
ENABLE_DEMO_SWITCHER="true"

# Batas maksimal ukuran unggahan berkas (foto, materi, berkas PPDB dalam MB)
UPLOAD_MAX_SIZE_MB="5"

# ------------------------------------------------------------------------------
# 2. IDENTITAS & METADATA SEKOLAH
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Portal Sekolah & CBT Terpadu"
NEXT_PUBLIC_SCHOOL_NAME="SMA Negeri Unggulan Bangsa"

# Zona waktu resmi sekolah (WIB = Asia/Jakarta, WITA = Asia/Makassar, WIT = Asia/Jayapura)
TIMEZONE="Asia/Jakarta"

# ------------------------------------------------------------------------------
# 3. SESI, COOKIE & ENKRIPSI PASSWORD
# ------------------------------------------------------------------------------
# Masa berlaku token sesi login
JWT_EXPIRES_IN="7d"

# Nama cookie penyimpan token sesi HttpOnly
SESSION_COOKIE_NAME="school_session_token"

# Faktor biaya salt enkripsi password bcrypt (Default: 10)
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. PENGATURAN MESIN UJIAN CBT (COMPUTER BASED TEST)
# ------------------------------------------------------------------------------
# Toleransi waktu keterlambatan jaringan sebelum sesi otomatis di-finalize oleh server (Detik)
CBT_AUTO_FINALIZE_TOLERANCE_SECONDS=120

# Ambang batas maksimal peringatan siswa berpindah tab/jendela browser sebelum terkunci
CBT_MAX_TAB_SWITCH_WARNING=3

# Kunci Safe Exam Browser (SEB) jika sekolah mewajibkan browser khusus ujian (Opsional)
SEB_CONFIG_KEY_HASH=""

# ------------------------------------------------------------------------------
# 5. PENYIMPANAN BERKAS & UPLOAD MEDIA
# ------------------------------------------------------------------------------
# Direktori penyimpanan unggahan lokal (materi, foto soal, foto siswa)
UPLOAD_DIR="./public/uploads"

# ------------------------------------------------------------------------------
# 6. ADMINISTRASI AKUN & LOG AUDIT
# ------------------------------------------------------------------------------
# Default password sementara untuk akun baru yang dicetak pada kartu peserta ujian
DEFAULT_STUDENT_INIT_PASSWORD="siswa123#2026"
DEFAULT_TEACHER_INIT_PASSWORD="guru123#2026"

# Retensi pencatatan log audit (Hari)
AUDIT_LOG_RETENTION_DAYS=90
